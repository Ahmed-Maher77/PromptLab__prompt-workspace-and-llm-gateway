{
  "name": "promptlab-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PromptLab — Prompt Engineering & LLM Gateway POC",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start:api": "npm --workspace=@promptlab/api run start:dev",
    "start:web": "npm --workspace=@promptlab/web run start",
    "start:gateway": "python infra/litellm/run_proxy.py",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace=@promptlab/api run build",
    "build:web": "npm --workspace=@promptlab/web run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm --workspace=@promptlab/api run test",
    "test:web": "npm --workspace=@promptlab/web run test",
    "typecheck": "npm --workspace=@promptlab/api run typecheck && npm --workspace=@promptlab/web run typecheck",
    "lint": "npm --workspace=@promptlab/api run lint && npm --workspace=@promptlab/web run lint",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:flows": "node scripts/run-e2e-flows.mjs --all",
    "prisma:generate": "npm --workspace=@promptlab/api run prisma:generate",
    "prisma:push": "npm --workspace=@promptlab/api run prisma:push",
    "prisma:deploy": "npm --workspace=@promptlab/api run prisma:deploy",
    "prisma:migrate": "npm --workspace=@promptlab/api run prisma:migrate"
  },
  "keywords": [
    "prompt-engineering",
    "llm-gateway",
    "litellm",
    "nestjs",
    "angular"
  ],
  "author": "PromptLab Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
