# PromptLab Environment Configuration Template
# DO NOT commit actual secrets or production keys to version control.
# Copy this file to .env for local development.

# Application Environment
NODE_ENV=development
PORT=3100

# CORS — comma-separated list of allowed origins (no trailing slash)
CORS_ORIGIN=http://localhost:4200

# Authentication (SEC-01 / SEC-01a-2)
# Comma-separated API keys in format: <key>:<userId>:<role>
# In production, every key MUST be at least 32 characters long.
# Generate strong keys with: openssl rand -base64 32
AUTH_API_KEYS=

# JWT secret for token signature verification (MUST be at least 32 characters in production)
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=

# Optional JWT claims checks
# AUTH_JWT_ISSUER=https://auth.promptlab.internal
# AUTH_JWT_AUDIENCE=promptlab-api
# AUTH_JWT_MAX_LIFETIME_SECONDS=86400

# Dev tokens: active ONLY when NODE_ENV is explicitly 'development' or 'test' AND AUTH_DEV_TOKENS_ENABLED=true
AUTH_DEV_TOKENS_ENABLED=false
# AUTH_DEV_ADMIN_TOKEN=
# AUTH_DEV_USER_TOKEN=

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# POSTGRES_PASSWORD is also required by docker-compose.yml (it rejects an unset/empty value).
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql://postgres:changeme_dev_only@localhost:5432/promptlab?schema=public

# LiteLLM Proxy Gateway Configuration
# LITELLM_GATEWAY_URL takes precedence; LITELLM_PROXY_URL is a deprecated alias.
LITELLM_GATEWAY_URL=http://localhost:4000
# PRODUCTION: set LITELLM_MASTER_KEY to a strong, random secret (never the dev default below).
LITELLM_MASTER_KEY=sk-promptlab-dev-key

# Upstream Provider Keys (Configured in LiteLLM Proxy or backend environment)
# Kept server-side only; NEVER exposed to the frontend or browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web Frontend Configuration
WEB_PORT=4200
API_BASE_URL=http://localhost:3100/api

# Observability (Langfuse / OpenTelemetry)
# Use ENABLE_TELEMETRY to toggle tracing (see docs/observability.md).
ENABLE_TELEMETRY=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
